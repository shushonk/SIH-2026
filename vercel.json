{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd krishiraksha-web && npm install && npm run build",
  "outputDirectory": "krishiraksha-web/dist",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://krishiraksha-backend.onrender.com/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
